generator client {
  provider   = "prisma-client"
  output     = "../lib/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  createdAt     DateTime       @default(now())
  passwordHash  String
  updatedAt     DateTime       @updatedAt
  totpEnabled   Boolean        @default(false)
  totpSecret    String?
  challenges    Challenge[]
  credentials   Credential[]
  recoveryCodes RecoveryCode[]
  sessions      Session[]
}

model Credential {
  id           String    @id @default(cuid())
  credentialID String    @unique
  publicKey    String
  counter      Int       @default(0)
  transports   String?
  aaguid       String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  userId       String
  name         String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  userId     String
  rotatedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Challenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}